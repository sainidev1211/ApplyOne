# ApplyOne Environment Variables
# Copy this file to .env and fill in actual values.
# VITE_* variables only: bundled into the browser bundle — keep everything else server-side only.

# ============================================================================
# FRONTEND (Vite — safe for browser)
# ============================================================================
# Local:      http://localhost:3000
# Production: https://your-backend.onrender.com
VITE_API_URL=http://localhost:3000

# ============================================================================
# SERVER & DEPLOYMENT
# ============================================================================
# Render sets PORT automatically; BACKEND_PORT is a local dev fallback.
PORT=3000
BACKEND_PORT=3000
NODE_ENV=development
UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE_MB=10

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# Generate a strong random value: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ============================================================================
# DATABASE — MongoDB ONLY
# ============================================================================
# This is the ONLY database used by this application.
# Format: mongodb+srv://user:password@cluster.mongodb.net/dbname?appName=AppName
# or:     mongodb://host:port/dbname
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/applyone?appName=ApplyOne

# NOTE: PostgreSQL / DATABASE_URL is NOT required.
# The application is MongoDB-only. Prisma is present as a stub and performs no real DB operations.

# ============================================================================
# CACHE & QUEUE — Redis/BullMQ (OPTIONAL)
# ============================================================================
# Leave blank to disable Redis cache and BullMQ queues.
# The application starts and runs without Redis.
# Set this only if you have a Redis instance (local, Redis Cloud, Upstash, etc.)
#
# Format: redis://[user:password@]host:port/[db]
#     or: rediss://[user:password@]host:port/[db]  (TLS — required by most cloud providers)
#
# Example (Upstash):  rediss://:password@hostname.upstash.io:6380
# Leave blank:        REDIS_URL=
REDIS_URL=

# ============================================================================
# EMAIL
# ============================================================================
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=ApplyOne <supportapplyone@gmail.com>

# ============================================================================
# URLs (for CORS and email links)
# ============================================================================
# Frontend URL — used for CORS allow-list and email verification links
# Local:      http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Backend public URL — used for OAuth callbacks (currently unused) and logging
# Local:      http://localhost:3000
# Production: https://your-backend.onrender.com
BACKEND_PUBLIC_URL=http://localhost:3000

# ============================================================================
# AI & EXTERNAL SERVICES
# ============================================================================
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ============================================================================
# OPTIONAL: GOOGLE OAUTH (currently disabled in code)
# ============================================================================
# Uncomment and configure if you re-enable Google sign-in.
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================================================
# OPTIONAL: STRIPE (if enabling payment features)
# ============================================================================
# STRIPE_SECRET_KEY=sk_test_your_stripe_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================================================
# OPTIONAL: SENTRY (error tracking)
# ============================================================================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
