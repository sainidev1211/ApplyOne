# ApplyOne Environment Configuration
# Copy this file to .env at the root of the project and replace with your credentials

# ── Frontend: Supabase ────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── Backend (backend/.env) ────────────────────────────────────
# The backend runs as a separate NestJS process in backend/
# Create backend/.env and add the variables below

# Server
BACKEND_PORT=3000
NODE_ENV=development

# JWT — replace with a strong random secret before production
JWT_SECRET=your-strong-jwt-secret-here
JWT_EXPIRES_IN=7d

# AI (Groq) — https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama3-8b-8192

# File Uploads
UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE_MB=10

# Database — Supabase PostgreSQL (added when DB phase begins)
# Use the connection string from: Supabase Dashboard → Settings → Database → Connection string
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
